+    throw new BuildError(`offline build: no prefetch entry for ${url}`, {
+      hint:
+        "Put the tarball at $BUN_BUILD_PREFETCH_DIR/by-url/<sha256(url)[:32]> " +
+        "(see vendor-sources.sh). The build will not download.",
+    });
+  }
+
   const maxAttempts = retry.attempts;
   let lastError: unknown;
   let permanent = false;
